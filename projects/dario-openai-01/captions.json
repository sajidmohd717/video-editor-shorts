  "paragraphs": [
    {
      "index": 0,
      "start": 0.0,
      "end": 5.42,
      "text": "The obvious explanation is a fight over AI safety. Dario says those disagreements weren't enough to make him leave."
    },
    {
      "index": 1,
      "start": 5.9,
      "end": 13.5,
      "text": "His breaking point was trust: whether the people steering OpenAI meant what they said, and whether their stated values were real."
    },
    {
      "index": 2,
      "start": 13.94,
      "end": 18.66,
      "text": "So he stopped arguing and built Anthropic. In his telling, the dispute now gets settled in public."
    }
  ]
}