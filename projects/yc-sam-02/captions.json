  "paragraphs": [
    {
      "index": 0,
      "start": 0.0,
      "end": 7.44,
      "text": "That isn't advice. That's manufacturing belief before any evidence exists for it, which is the rarest thing a mentor can actually do."
    },
    {
      "index": 1,
      "start": 8.2,
      "end": 18.0,
      "text": "Most of those eight companies never became Google. Y Combinator did. It exists because one person decided to act as if it would work every Tuesday, over dinner."
    }
  ]
