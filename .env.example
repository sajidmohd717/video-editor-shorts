# Copy this file to `.env` and fill in your own keys.
# `.env` is gitignored — never commit real keys.

# --- ElevenLabs (voice) -----------------------------------------------------
# https://elevenlabs.io/app/settings/api-keys
ELEVENLABS_API_KEY=
# Voice ID from https://elevenlabs.io/app/voice-library (copy the ID, not the name)
ELEVENLABS_VOICE_ID=
# eleven_multilingual_v2 = best all-round narration quality
# eleven_turbo_v2_5      = ~3x cheaper, slightly flatter prosody. Good for drafts.
ELEVENLABS_MODEL=eleven_multilingual_v2

# --- Stock footage ----------------------------------------------------------
# Free, instant: https://www.pexels.com/api/
PEXELS_API_KEY=
# Free, instant: https://pixabay.com/api/docs/
PIXABAY_API_KEY=

# --- Optional ---------------------------------------------------------------
# Whisper model size: tiny | base | small | medium | large-v3
# `small` is the sweet spot on CPU for clean TTS audio.
WHISPER_MODEL=small
